{
  "name": "myagent",
  "version": "0.13.3",
  "type": "module",
  "license": "MIT",
  "description": "A personal proactive agent as a DSH (DeepSeek Harness) bundle: cron schedules and a local inbox directory become Triggers, a deterministic gate turns them into authorized Tickets, and each Ticket runs in its own DSH Session and directory, reporting back through a panel and the file system.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "examples",
    "README.md",
    "prompts",
    "panel",
    "bridges"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm build && pnpm test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.3"
  },
  "packageManager": "pnpm@11.28.5",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-permission-presets": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-scope": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-skill": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-workspace": "^0.2.1-alpha.3",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.3",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.8",
    "jsdom": "^30.1.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zod": "4.4.3"
  }
}
